datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Service {
  id            String      @id @default(cuid())
  slug          String      @unique
  titleId       String
  titleEn       String?
  descriptionId String
  descriptionEn String?
  featuresId    String[]    @default([])
  featuresEn    String[]    @default([])
  icon          String?
  order         Int         @default(0)
  isActive      Boolean     @default(true)
  portfolios    Portfolio[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([isActive, order])
}

model PortfolioCategory {
  id         String      @id @default(cuid())
  slug       String      @unique
  nameId     String
  nameEn     String?
  order      Int         @default(0)
  portfolios Portfolio[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([order])
}

model Portfolio {
  id          String            @id @default(cuid())
  slug        String            @unique
  titleId     String
  titleEn     String?
  summaryId   String
  summaryEn   String?
  challengeId String?
  challengeEn String?
  solutionId  String?
  solutionEn  String?
  resultId    String?
  resultEn    String?
  coverUrl    String
  gallery     String[]          @default([])
  link        String?
  videoUrl    String?
  client      String?
  year        String?
  teamNote    String?
  featured    Boolean           @default(false)
  order       Int               @default(0)
  isPublished Boolean           @default(true)
  categoryId  String
  category    PortfolioCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  serviceId   String?
  service     Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([categoryId, isPublished, order])
  @@index([featured])
}

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  roleId    String
  roleEn    String?
  bioId     String?
  bioEn     String?
  skills    String[] @default([])
  photoUrl  String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, order])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  interest  String?
  message   String
  locale    String   @default("id")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
}

model SiteSettings {
  id            String   @id @default("singleton")
  headerLogoUrl String?
  footerLogoUrl String?
  email         String   @default("hampiragency@gmail.com")
  whatsapp      String   @default("6281234567890")
  address       String?  @default("Batam, Kepulauan Riau, Indonesia")
  latitude      Float?   @default(1.0456)
  longitude     Float?   @default(104.0305)
  instagram     String?
  linkedin      String?
  github        String?
  twitter       String?
  ogImageUrl    String?
  statsJson     Json?
  updatedAt     DateTime @updatedAt
}

